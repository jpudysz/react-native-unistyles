{
  "name": "react-native-unistyles-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "precommit": "bun run --cwd packages/unistyles precommit",
    "lint": "bun run --cwd packages/unistyles lint",
    "test": "bun run --cwd packages/unistyles test",
    "test:ssr": "bun run --cwd packages/unistyles prepare && bun run test:ssr:exports && bun run test:ssr:concurrency && bun run test:ssr:resources && bun run --cwd apps/next-ssr-e2e test:e2e",
    "test:ssr:concurrency": "node --conditions react-server apps/next-ssr-e2e/tests/server-services-concurrency.cjs",
    "test:ssr:exports": "node apps/next-ssr-e2e/tests/conditional-exports.cjs",
    "test:ssr:resources": "node --conditions react-server apps/next-ssr-e2e/tests/server-host-resources.cjs",
    "tsc": "bun run --cwd packages/unistyles tsc",
    "check": "bun run --cwd packages/unistyles check",
    "check:ci": "bun run --cwd packages/unistyles check:ci"
  },
  "devDependencies": {
    "husky": "9.1.7"
  },
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">= 20.18.0"
  }
}
